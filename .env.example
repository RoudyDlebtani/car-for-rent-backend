# Copy this file to ".env" and fill in your values.
# cp .env.example .env

# ── Server ──────────────────────────────────────────────
PORT=5000
CLIENT_ORIGIN=http://localhost:3000

# ── Auth ────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# ── Database (local) ────────────────────────────────────
# Either set the discrete PG* vars below...
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=your-local-postgres-password
PGDATABASE=my-rental-car

# ...OR set a single connection string (takes precedence if present).
# For deployment (Neon/Supabase) use this with SSL enabled.
# DATABASE_URL=postgresql://user:pass@host:5432/my-rental-car
# PGSSL=true

# ── Rate limiting ───────────────────────────────────────
# All optional — sensible defaults are baked in. Per-IP limits.
# Global limit on all /api traffic (default 100 requests / 60s):
# RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_MAX=100
# Strict limit for login + register, and for favorites writes
# (default window 15 min; 10 auth attempts, 40 favorite writes per IP):
# RATE_LIMIT_AUTH_WINDOW_MS=900000
# RATE_LIMIT_AUTH_MAX=10
# RATE_LIMIT_WRITE_MAX=40
